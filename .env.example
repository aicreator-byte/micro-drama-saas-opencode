# Micro Drama SaaS - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Micro Drama SaaS
APP_VERSION=1.0.0
API_V1_STR=/api/v1

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-min-32-chars-change-in-production
ENCRYPTION_KEY=your-encryption-key-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For local development with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./micro_drama.db
# For production with PostgreSQL:
DATABASE_URL=postgresql+asyncpg://micro_drama:changeme@localhost:5432/micro_drama

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Google Accounts
GOOGLE_ACCOUNTS_MAX_PER_USER=20

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Round 2 — Asset storage (default local; S3 bila dikonfigurasi)
# STORAGE_BACKEND=local
# ASSET_STORAGE_DIR=./uploads/assets
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_CDN_BASE_URL=

# Round 2 — Billing Stripe (TEST MODE SAJA; sk_live_ ditolak kode)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_STUDIO=

# Round 2 — Harga LLM estimasi (USD per 1 juta token; override per model)
# LLM_PRICE_NVIDIA_NEMOTRON_3_ULTRA_550B_A55B=
